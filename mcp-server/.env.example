# MySQL settings for the WordPress DB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workshop
DB_USER=root
DB_PASSWORD=

# Optional: if you want the server to use a specific WordPress table prefix.
# By default it targets the same schema used by Workshop: wp_ + ws_ prefixes.
DB_TABLE_PREFIX=wp_

# MCP server
PORT=3001

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#FFFFFF",
          "name": "Base",
          "slug": "base"
        },
        {
          "color": "#0F172A",
          "name": "Contrast",
          "slug": "contrast"
        },
        {
          "color": "#2563EB",
          "name": "Primary",
          "slug": "primary"
        },
        {
          "color": "#0EA5E9",
          "name": "Secondary",
          "slug": "secondary"
        },
        {
          "color": "#F8FAFC",
          "name": "Muted",
          "slug": "muted"
        },
        {
          "color": "#DC2626",
          "name": "Accent",
          "slug": "accent"
        }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        },
        {
          "fontFamily": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
          "name": "System Mono",
          "slug": "system-mono"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "Extra Large",
          "size": "1.75rem",
          "slug": "x-large"
        },
        {
          "name": "2XL",
          "size": "2.5rem",
          "slug": "2xl"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "clamp(1rem, 3vw, 2rem)",
        "right": "clamp(1rem, 3vw, 2rem)"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "999px"
        },
        "typography": {
          "fontWeight": "600"
        }
      },
      "core/heading": {
        "typography": {
          "fontWeight": "700"
        }
      }
    }
  },
  "customTemplates": [],
  "templateParts": []
}
